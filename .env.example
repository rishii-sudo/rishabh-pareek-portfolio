# Free server-side FormSubmit target (email or anonymized FormSubmit token after activation).
# Keep server-side only; do not expose in PUBLIC_* variables.
FORMSUBMIT_TARGET=

# Optional fallback during testing: SendGrid API key for server-side email delivery.
# If neither FormSubmit nor SendGrid is configured, the contact form provides a functional mailto: fallback.
SENDGRID_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=fremindly@gmail.com
