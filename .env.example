# Optional: SendGrid or Resend API key for server-side contact form email delivery.
# If neither is configured, the contact form provides a functional mailto: fallback.
SENDGRID_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=fremindly@gmail.com

# Optional: Cloudflare Turnstile or Google reCAPTCHA v3 keys for spam protection
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
