# Browser-visible FormSubmit endpoint identifier (NOT a secret).
# Temporarily set to fremindly@gmail.com for initial activation, then replace with
# the anonymized FormSubmit token so the recipient email is not exposed in production.
PUBLIC_FORMSUBMIT_TARGET=

# Optional server-side fallback (retained until browser-side FormSubmit is verified,
# and for non-JavaScript form submissions).
SENDGRID_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=fremindly@gmail.com
